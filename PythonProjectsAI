      entries.slice(0, 5).forEach((entry, index) => {
        const li = document.createElement('li');
        li.innerHTML = `<span>${index + 1}. ${entry.name}</span><span>${entry.score}分</span>`;
        leaderboardEl.appendChild(li);
      });
    }

    function refreshLeaderboard() {
      getLeaderboard().then(renderLeaderboard);
    }

    function recordScore(score) {
      const payload = {
        name: (playerNameInput.value || '玩家').trim() || '玩家',
        score,
        difficulty: difficultyLabel.textContent,
        level: Number(levelLabel.textContent || 1),
        moves,
        seconds: (Date.now() - startTime) / 1000
      };
      fetch('/api/score', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      }).then(() => refreshLeaderboard());
    }

    function generateMaze(size) {
      const cells = Array.from({ length: size }, () => Array(size).fill(1));
      const stack = [{ x: 0, y: 0 }];
      cells[0][0] = 0;

      while (stack.length > 0) {
        const current = stack[stack.length - 1];
        const directions = [[0, 2], [2, 0], [0, -2], [-2, 0]].sort(() => Math.random() - 0.5);
        let moved = false;

        for (const [dx, dy] of directions) {
          const nx = current.x + dx;
          const ny = current.y + dy;
          if (nx >= 0 && nx < size && ny >= 0 && ny < size && cells[ny][nx] === 1) {
            cells[ny][nx] = 0;
            cells[current.y + dy / 2][current.x + dx / 2] = 0;
            stack.push({ x: nx, y: ny });
            moved = true;
            break;
          }
        }

        if (!moved) stack.pop();
      }

      cells[0][0] = 0;
      cells[size - 1][size - 1] = 0;
      return cells;
    }

    function findPath(startX, startY, endX, endY) {
      const queue = [[startX, startY]];
      const visited = new Set([`${startX},${startY}`]);
      const previous = new Map();

      while (queue.length) {
        const [x, y] = queue.shift();
        if (x === endX && y === endY) break;
        const neighbors = [[0, -1], [1, 0], [0, 1], [-1, 0]];
        for (const [dx, dy] of neighbors) {
          const nx = x + dx;
          const ny = y + dy;
          if (nx >= 0 && nx < maze.length && ny >= 0 && ny < maze.length && maze[ny][nx] === 0 && !visited.has(`${nx},${ny}`)) {
            visited.add(`${nx},${ny}`);
            previous.set(`${nx},${ny}`, [x, y]);
            queue.push([nx, ny]);
          }
        }
      }

      const path = [];
      let curX = endX;
      let curY = endY;
      while (curX !== startX || curY !== startY) {
        path.push({ x: curX, y: curY });
        const key = `${curX},${curY}`;
        if (!previous.has(key)) break;
        [curX, curY] = previous.get(key);
      }
      path.push({ x: startX, y: startY });
      path.reverse();
      return path;
    }

    function renderMiniMap() {
      const size = maze.length;
      miniMapEl.style.gridTemplateColumns = `repeat(${size}, 10px)`;
      miniMapEl.innerHTML = '';
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const cell = document.createElement('div');
          const inHint = hintPath.some(p => p.x === x && p.y === y);
          const isPlayer = player.x === x && player.y === y;
          const isGoal = goal.x === x && goal.y === y;
          cell.className = 'mini-cell ' + (maze[y][x] === 1 ? 'mini-wall' : 'mini-path');
          if (isPlayer) cell.classList.add('mini-player');
          if (isGoal) cell.classList.add('mini-goal');
          if (inHint && !isPlayer && !isGoal) cell.classList.add('mini-goal');
          miniMapEl.appendChild(cell);
        }
      }
    }

    function drawMaze() {
      const size = maze.length;
      mazeEl.style.gridTemplateColumns = `repeat(${size}, 28px)`;
      mazeEl.innerHTML = '';

      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const cell = document.createElement('div');
          const isWall = maze[y][x] === 1;
          const isPlayer = player.x === x && player.y === y;
          const isGoal = goal.x === x && goal.y === y;
          const isHint = hintPath.some(p => p.x === x && p.y === y);

          cell.className = 'cell ' + (isWall ? 'wall' : 'path');
          if (isPlayer) cell.classList.add('player');
          if (isGoal) cell.classList.add('goal');
          if (isHint && !isPlayer && !isGoal) cell.classList.add('hint');
          mazeEl.appendChild(cell);
        }
      }
      renderMiniMap();
    }

    function updateStats() {
      const elapsed = (Date.now() - startTime) / 1000;
      timerEl.textContent = `${elapsed.toFixed(1)}s`;
      const levelBonus = (levelIndex - 1) * 150;
      const currentScore = Math.max(0, Math.round(2000 - elapsed * 20 - moves * 10 + levelBonus));
      scoreEl.textContent = currentScore;
      movesEl.textContent = moves;
    }

    function stopTimer() {
      if (timerId) clearInterval(timerId);
      timerId = null;
    }

    function startTimer() {
      stopTimer();
      startTime = Date.now();
      timerId = setInterval(updateStats, 100);
    }

    function isWalkable(x, y) {
      return x >= 0 && x < maze.length && y >= 0 && y < maze.length && maze[y][x] === 0;
    }

    function finishGame() {
      finished = true;
      stopTimer();
      const elapsed = (Date.now() - startTime) / 1000;
      const levelBonus = (levelIndex - 1) * 150;
      const finalScore = Math.max(0, Math.round(2000 - elapsed * 20 - moves * 10 + levelBonus));
      scoreEl.textContent = finalScore;
      messageEl.textContent = `胜利！本关用时 ${elapsed.toFixed(1)} 秒，分数 ${finalScore}。`;
      recordScore(finalScore);
      beep(880, 0.18, 'triangle', 0.05);
      setTimeout(() => beep(660, 0.2, 'triangle', 0.05), 120);
      setTimeout(() => beep(990, 0.22, 'triangle', 0.05), 260);
      setTimeout(() => {
        if (levelIndex < 3) {
          levelIndex += 1;
          startGame(false);
          messageEl.textContent = `恭喜通关，第 ${levelIndex} 关已开始！`;
        } else {
          messageEl.textContent = `全部关卡挑战完成，最终分数 ${finalScore}，已写入排行榜。`;
        }
      }, 1200);
    }

    function movePlayer(dx, dy) {
      if (finished) return;
      const nx = player.x + dx;
      const ny = player.y + dy;

      if (!isWalkable(nx, ny)) {
        messageEl.textContent = '前方是墙，不能过去！';
        beep(120, 0.08, 'square', 0.02);
        return;
      }

      player.x = nx;
      player.y = ny;
      moves += 1;
      hintPath = [];
      beep(450, 0.06, 'sine', 0.03);
      drawMaze();
      updateStats();

      if (player.x === goal.x && player.y === goal.y) {
        finishGame();
      } else {
        messageEl.textContent = '继续前进，目标就在前方！';
      }
    }

    function showHint() {
      if (finished) return;
      const path = findPath(player.x, player.y, goal.x, goal.y);
      if (path.length <= 2) {
        messageEl.textContent = '目标就在你附近，直接冲过去！';
        return;
      }
      hintPath = path.slice(1, Math.min(path.length, 8));
      drawMaze();
      messageEl.textContent = '提示：路线已高亮，跟着它前进。';
      beep(700, 0.1, 'triangle', 0.04);
    }

    function initDifficultyButtons() {
      difficultyButtons.forEach(button => {
        button.addEventListener('click', () => {
          currentDifficulty = button.dataset.difficulty;
          difficultyButtons.forEach(btn => btn.classList.toggle('active', btn === button));
          difficultyLabel.textContent = LEVELS[currentDifficulty].label;
        });
      });
    }

    function startGame(resetLevel = true) {
      if (resetLevel) {
        levelIndex = 1;
      }
      const config = LEVELS[currentDifficulty];
      const size = config.size + (levelIndex - 1) * 2;
      maze = generateMaze(size);
      player = { x: 0, y: 0 };
      goal = { x: size - 1, y: size - 1 };
      moves = 0;
      finished = false;
      hintPath = [];
      levelLabel.textContent = String(levelIndex);
      difficultyLabel.textContent = config.label;
      messageEl.textContent = `第 ${levelIndex} 关已生成，开始冒险！`;
      drawMaze();
      updateStats();
      startTimer();
      startScreen.classList.add('hidden');
      beep(440, 0.10, 'triangle', 0.04);
    }

    document.addEventListener('keydown', (event) => {
      const key = event.key.toLowerCase();
      if (key === 'w' || key === 'arrowup') movePlayer(0, -1);
      else if (key === 's' || key === 'arrowdown') movePlayer(0, 1);
      else if (key === 'a' || key === 'arrowleft') movePlayer(-1, 0);
      else if (key === 'd' || key === 'arrowright') movePlayer(1, 0);
    });

    startGameBtn.addEventListener('click', () => startGame(true));
    newGameBtn.addEventListener('click', () => {
      startScreen.classList.remove('hidden');
      stopTimer();
      timerEl.textContent = '0.0s';
      scoreEl.textContent = '0';
      movesEl.textContent = '0';
      messageEl.textContent = '已返回开始界面。';
    });
    restartBtn.addEventListener('click', () => startGame(false));
    hintBtn.addEventListener('click', showHint);

    initDifficultyButtons();
    refreshLeaderboard();
    difficultyLabel.textContent = LEVELS[currentDifficulty].label;
    startScreen.classList.remove('hidden');
  </script>
</body>
</html>
"""


@app.route("/")
def index():
    return render_template_string(HTML)


@app.route("/api/leaderboard")
def api_leaderboard():
    return jsonify(load_leaderboard())


@app.route("/api/score", methods=["POST"])
def api_score():
    payload = request.get_json(silent=True) or {}
    name = str(payload.get("name", "玩家")).strip() or "玩家"
    score = int(payload.get("score", 0))
    difficulty = str(payload.get("difficulty", "简单"))
    level = int(payload.get("level", 1))
    moves = int(payload.get("moves", 0))
    seconds = float(payload.get("seconds", 0.0))

    entries = load_leaderboard()
    entries.append({
        "name": name,
        "score": score,
        "difficulty": difficulty,
        "level": level,
        "moves": moves,
        "seconds": round(seconds, 1)
    })
    entries = sorted(entries, key=lambda x: x.get("score", 0), reverse=True)[:10]
    save_leaderboard(entries)
    return jsonify({"ok": True, "entries": entries})


